<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="mellis"
        Arguments=""
        InstallLocation="C:\Program Files\Toni Lam\Mellis">
    </Installer>
    <PackageInformation
        PackageName="Mellis"
        PackageDisplayName="Mellis"
        PublisherName="CN=Toni Lam"
        PublisherDisplayName="Toni Lam"
        Version="0.1.0.0"
        PackageDescription="Local E2E runner">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
